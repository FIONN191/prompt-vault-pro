{
  "name": "prompt-vault-pro",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app:dev": "VITE_DEV_SERVER_URL=http://localhost:5177 electron .",
    "dist": "vite build && mkdir -p '/Volumes/SN580 1TB Media/开发/PromptVaultPro/tmp' && TMPDIR='/Volumes/SN580 1TB Media/开发/PromptVaultPro/tmp' electron-builder --mac --win",
    "dist:mac": "vite build && mkdir -p '/Volumes/SN580 1TB Media/开发/PromptVaultPro/tmp' && TMPDIR='/Volumes/SN580 1TB Media/开发/PromptVaultPro/tmp' electron-builder --mac",
    "dist:win": "vite build && electron-builder --win"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.8",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.fionn.promptvaultpro",
    "productName": "PromptVaultPro",
    "directories": {
      "output": "/Volumes/SN580 1TB Media/开发/PromptVaultPro/release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "PromptVaultPro-${version}-mac.${ext}",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PromptVaultPro-Setup-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
